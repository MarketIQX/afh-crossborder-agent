# Copy to .env and fill in. .env is git-ignored and must never be committed.
# The real process environment always overrides values in this file.

# --- Database (single contract shared by compose, app and tests) ---
# Required. No default is provided for either password.
POSTGRES_ADMIN_PASSWORD=
POSTGRES_APP_PASSWORD=

# Optional. Shown with the defaults used when unset.
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5433
# POSTGRES_DB=agents_for_humans
# POSTGRES_ADMIN_USER=agents_admin
# POSTGRES_APP_USER=agents_app

# --- Gmail transport ---
GOOGLE_OAUTH_CLIENT_FILE=C:\path\outside\repo\google_oauth_client.json
GMAIL_TOKEN_FILE=C:\path\outside\repo\gmail_token.json
GMAIL_EXPECTED_ADDRESS=your-agent-mailbox@example.com
# The one address outbound test sends may reach. Unset means
# no send is permitted, which is the safe default.
# GMAIL_TEST_RECIPIENT=

# --- Human approval gates for outbound send scripts ---
# Left unset on purpose. Setting these enables real outbound email.
# GMAIL_SEND_SMOKE_APPROVED=
# GMAIL_EXTERNAL_SEND_APPROVED=

# --- AWS, for the Bedrock path ---
# Both of these are required before any model invocation. The identity
# gate refuses when either is unset and has no override, so an
# unchecked principal can never reach the model.
# AFH_AWS_ACCOUNT_ID=
# AFH_AWS_EXPECTED_PRINCIPAL=arn:aws:iam::<account>:user/afh-claude-deployer
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
