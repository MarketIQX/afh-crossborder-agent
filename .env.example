# Generated by scripts/generate_env_example.py. Do not edit by hand.
#
# Copy this file to .env and fill in the values. .env is gitignored and
# must never be committed. Keys marked REQUIRED have no default: the
# software refuses to run the affected part rather than guessing.
#
# Nothing here is a real credential. The AWS account id and principal
# below are placeholders; substitute your own.


# ------------------------------------------------------------------
# PostgreSQL. Required for everything.
# ------------------------------------------------------------------

# [REQUIRED] Owns the schema. Used by bootstrap and migrations only.
POSTGRES_ADMIN_PASSWORD=change-me-admin

# [REQUIRED] The runtime role. Can draft and dispatch, cannot approve.
POSTGRES_APP_PASSWORD=change-me-app

# [REQUIRED] The reviewer role. Can approve, cannot dispatch.
POSTGRES_REVIEWER_PASSWORD=change-me-reviewer

# [optional] Defaults to 127.0.0.1.
POSTGRES_HOST=127.0.0.1

# [optional] Defaults to 5433, matching docker-compose.
POSTGRES_PORT=5433

# [optional] Defaults to agents_for_humans.
POSTGRES_DB=agents_for_humans

# [optional] Defaults to agents_admin.
POSTGRES_ADMIN_USER=agents_admin

# [optional] Defaults to agents_app.
POSTGRES_APP_USER=agents_app

# [optional] Defaults to agents_reviewer.
POSTGRES_REVIEWER_USER=agents_reviewer

# ------------------------------------------------------------------
# The reviewer console. Who it acts as.
# ------------------------------------------------------------------

# [optional] Which personal agent a background run acts as, when its owner has more than one active profile. Empty is fine when the owner has exactly one; resolution refuses rather than guessing if it is ambiguous.
AGENT_ACTING_PROFILE_ID=

# [optional] The agent's product-facing name. Presentation only: nothing decides anything by it.
AGENT_DISPLAY_NAME=Nicole

# [optional] Who the console acts as, by reviewer id or email. Bound at startup; no request can change it. Empty means no authority at all, not a default reviewer. Not authentication.
CONSOLE_ACTING_REVIEWER=

# ------------------------------------------------------------------
# Which model answers. Bedrock is the default.
# ------------------------------------------------------------------

# [optional] Which provider answers a run: bedrock, anthropic or groq. Defaults to bedrock, so an unset value is the behaviour this project has always had. A provider that cannot be built refuses rather than substituting another one.
MODEL_PROVIDER=bedrock

# [optional] Read only when MODEL_PROVIDER is anthropic. Requires the provider extra: pip install 'strands-agents[anthropic]'.
ANTHROPIC_API_KEY=change-me-anthropic-key

# [optional] Read only when MODEL_PROVIDER is groq. Requires the provider extra: pip install 'strands-agents[openai]'. Groq supplies inference only; Strands keeps the agent loop and the tools.
GROQ_API_KEY=change-me-groq-key

# [optional] Model id for the Groq provider. A candidate rather than a decision until a real eval has run against it.
GROQ_MODEL_ID=openai/gpt-oss-120b

# [optional] Groq's OpenAI-compatible endpoint, reached through Strands' own OpenAIModel rather than a custom adapter.
GROQ_BASE_URL=https://api.groq.com/openai/v1

# [optional] Model id for the Anthropic provider. Unproven until a real invocation succeeds against it.
ANTHROPIC_MODEL_ID=claude-sonnet-5

# ------------------------------------------------------------------
# AWS Bedrock. Required when MODEL_PROVIDER is bedrock.
# ------------------------------------------------------------------

# [optional] Region for Bedrock. Defaults to us-east-1.
AWS_REGION=us-east-1

# [optional] Named profile in your AWS credentials file. Optional.
AWS_PROFILE=your-aws-profile

# [optional] Inference profile id. Defaults to Claude Sonnet 4.5.
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# [REQUIRED] Required whenever MODEL_PROVIDER is bedrock, which is the default. Your own 12 digit account id. Without it no Bedrock call is attempted at all. Not read by any other provider: the identity gate runs only when requires_aws().
AFH_AWS_ACCOUNT_ID=000000000000

# [REQUIRED] Required whenever MODEL_PROVIDER is bedrock. The exact caller ARN expected; root is refused even when it matches the account. Not read by any other provider.
AFH_AWS_EXPECTED_PRINCIPAL=arn:aws:iam::000000000000:user/your-deploy-user

# ------------------------------------------------------------------
# Gmail. Required to ingest real mail or send a real reply.
# ------------------------------------------------------------------

# [REQUIRED] OAuth client JSON from Google Cloud. Keep it out of the repo.
GOOGLE_OAUTH_CLIENT_FILE=C:\path\outside\repo\google_oauth_client.json

# [REQUIRED] Where the authorised token is persisted. Out of the repo.
GMAIL_TOKEN_FILE=C:\path\outside\repo\gmail_token.json

# [REQUIRED] The mailbox the token must belong to. Checked before any read or send, so a token for the wrong account is refused.
GMAIL_EXPECTED_ADDRESS=agent-mailbox@example.com

# [optional] Gmail search that defines what counts as a client enquiry. Empty means the whole mailbox, which is only correct for a dedicated advisory address. Deciding which mail is an enquiry is the firm's judgement, not something the agent infers.
GMAIL_INGEST_QUERY=label:client-enquiries

# ------------------------------------------------------------------
# Deliberately absent: CONSOLE_REAL_SEND_APPROVED, GMAIL_EXTERNAL_SEND_APPROVED, GMAIL_EXTERNAL_TEST_RECIPIENT, GMAIL_ROUNDTRIP_STATE_FILE, GMAIL_SEND_SMOKE_APPROVED, GMAIL_TEST_RECIPIENT.
# These authorise a real outbound send. They are read straight
# from the process environment so that sending real mail is
# always a deliberate act in a shell, never inherited from a
# file that someone copied.
